# Supabase (required for a provisioned instance; app runs in demo mode without them)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by queue consumers and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (system mail only — never sends as a user's address)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# QuickBooks Online (optional module; register an Intuit app first — see SETUP.md)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_WEBHOOK_VERIFIER_TOKEN=

# Connected email (optional modules; operator-registered OAuth apps — see SETUP.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Error tracking (optional)
SENTRY_DSN=
